DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
PORT=4200

# Pre-launch gate — keeps the public site to a blank "coming soon" page.
# Visit yoursite.com/?key=PREVIEW_KEY once to unlock it for your browser
# (sets a 90-day cookie); everyone else only ever sees coming-soon.html.
# Set SITE_LOCKED=false to open the site to everyone once you're ready.
SITE_LOCKED=true
PREVIEW_KEY=change-me-to-a-long-random-string

# Required for the "Generate more questions" button in admin (Lineup tab).
# Both are required — questions are drafted with Anthropic, then verified by
# two independent blind judges (Anthropic + OpenAI) before going live. See
# server/question_gen.js.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides, default to a current model on each side.
# QUESTION_GEN_ANTHROPIC_MODEL=claude-sonnet-4-5
# QUESTION_GEN_OPENAI_MODEL=gpt-4.1

# Real token-pack payments via SeamlessChex (see server/payments.js). Leave
# unset and the site quietly stays on the demo instant-credit "purchase"
# flow — set all three once your merchant account is approved and you have
# real API credentials. The actual outbound checkout-creation call still
# needs finishing against SeamlessChex's real API reference (blocked to
# automated fetching while this was built) — see the TODO in payments.js.
SEAMLESSCHEX_API_KEY=
SEAMLESSCHEX_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Real token-pack payments via PayPal Smart Buttons (see server/paypal.js) —
# a complete, working integration since PayPal's API is public, unlike
# SeamlessChex's above. Use a PayPal account dedicated ONLY to FestIQ, not
# an umbrella account shared with other businesses — see the warning at the
# top of paypal.js for why. Get these from developer.paypal.com (create an
# app under your dedicated account). Leave PAYPAL_ENV as "sandbox" until
# you're ready to take real money — sandbox uses fake test accounts/money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Optional one-time seed for the traffic-exclude-IPs list (your own visits —
# testing, QA, just checking the site — so they don't inflate "real" traffic
# numbers in the admin Traffic tab). Only used to pre-fill the list the
# FIRST time the app starts with an empty database; after that, manage it
# entirely from the Traffic tab's "Recent visitor IPs" table (Exclude
# button per IP) or the Add IP box — no redeploy needed. Has no effect on
# anything except this analytics beacon.
# Set your REAL IP only in your actual deployment env / .env file — never
# in this .env.example, since that file gets committed to git.
TRAFFIC_EXCLUDE_IPS=203.0.113.7
